# Copy this file to .env in the project root and fill in the values.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# NEVER commit .env. NEVER paste a private key into chat, git, or a script.

# Deployer wallet private key. Hex, with or without 0x prefix.
# This wallet pays gas and becomes Ownable owner of a newly deployed StarForgeGame.
PRIVATE_KEY=

# Optional RPC overrides. Testnet default is already set in hardhat.config.js.
SOMNIA_TESTNET_RPC=https://dream-rpc.somnia.network

# Mainnet RPC — placeholder. Fill this before any somniaMainnet deploy.
SOMNIA_MAINNET_RPC=https://REPLACE_WITH_SOMNIA_MAINNET_RPC

# Existing persistent contracts (constructor args for StarForgeGame).
# Testnet defaults below match DEPLOYMENT.md (20 May 2026).
# On somniaMainnet these three MUST be set explicitly — testnet defaults are rejected.
UNIT_NFT_ADDRESS=0x9c8784d47dA7fc4772EE617dC3A49c506A6481A1
RELIC_ADDRESS=0x619e19df1975A8D289545834aAff3FEEf1b84909
PLAYER_PROFILE_ADDRESS=0x2C8976ECc9e9bDf939745ee61b1aD858607563d9

# Live Game to pass as previousGame in the new Game constructor.
# Testnet default matches DEPLOYMENT.md. Required on somniaMainnet.
CURRENT_GAME_ADDRESS=0x064fE7661b1eb52b727e562E652764b94c008383

# Must be 1 to deploy on somniaMainnet. Ignored on testnet.
CONFIRM_MAINNET=
